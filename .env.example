NEXT_PUBLIC_API_URL=http://localhost:8000

APP_NAME=Kiko API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGINS=http://localhost:3000

POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0
SERVICE_CONNECT_TIMEOUT_SECONDS=2

# Development-only example. Replace with at least 32 random characters outside local use.
AUTH_SECRET_KEY=development-only-insecure-secret-change-me
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_FAIL_OPEN=true
AUTH_CLEANUP_RETENTION_DAYS=7

AGENT_MAX_CONTEXT_CHARS=20000
AGENT_MAX_ACTIONS_PER_TASK=10
AGENT_MAX_FEEDBACK_CHARS=5000
# AI planning. OPENAI_API_KEY is optional until Supervisor planning is invoked.
# Never commit a real key. Replace the example model with an enabled model if needed.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
SUPERVISOR_MAX_TASKS=20
SUPERVISOR_MAX_COMMAND_CHARS=10000
SUPERVISOR_MAX_FEEDBACK_CHARS=5000

# Execution Engine. PostgreSQL stores state; Redis/Celery only transports work.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=
EXECUTION_DEFAULT_TIMEOUT_SECONDS=60
EXECUTION_MAX_RETRIES=3
EXECUTION_STALE_AFTER_SECONDS=900
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
